# Every setting in src/config.ts can be overridden from here, as the app is
# built. Nothing has to be: left unset, the value written in config.ts is used.
#
# Copy the lines you want into a file called .env.local, which is not committed.
# That is the right place for anything specific to your own machine — a test
# member list address above all, so it never ends up published.
#
# These are read when the app is BUILT, not when it runs. Change one and you
# have to build again (or restart `pnpm dev`) for it to take effect.

# ---------------------------------------------------------------------------
# The member list
# ---------------------------------------------------------------------------

# The address of the Apps Script web app that serves the member list. NEEDED
# for development: config.ts deliberately holds only a placeholder (it explains
# why), so without this the app can't download the list. Point it at a test
# deployment while working on the app.
# VITE_MEMBER_LIST_URL=https://script.google.com/macros/s/.../exec

# How old the copy on the device may get, in milliseconds, before the app asks
# for a fresh one. Default is a week. Set it to something tiny to see the
# "member list is old" pop-up without waiting.
# VITE_MEMBER_LIST_MAX_AGE_MS=10000

# ---------------------------------------------------------------------------
# The rest
# ---------------------------------------------------------------------------

# The shared passcode, as a SHA-256 hash — useful for building with a real
# passcode without committing it.
#   echo -n "newpasscode" | sha256sum        (Linux, Git Bash)
#   echo -n "newpasscode" | shasum -a 256    (Mac)
# VITE_PASSCODE_HASH=

# How long the Scan button looks at the camera before giving up, in
# milliseconds. Default 5000.
# VITE_SCAN_TIMEOUT_MS=5000

# What a student number looks like, as a regular expression. Must agree with
# STUDENT_ID_PATTERN in apps-script/members.gs.
# VITE_STUDENT_ID_PATTERN=^[1-9]\d{7}$

# The person shown as the contact on the passcode and help screens.
# VITE_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Treat a missing or refused camera as non-fatal instead of showing the error
# page, so the rest of the app can be worked on without one. Ignored in a real
# build. See camera.ts.
# VITE_ALLOW_MISSING_CAMERA=true
